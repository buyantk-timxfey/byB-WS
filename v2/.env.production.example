# ── byBuka 2.0 · продакшн (.env) ──
# Скопировать в .env на сервере и заполнить. НЕ коммитить.

APP_NAME=byBuka
APP_ENV=production
APP_KEY=                      # сгенерировать: php artisan key:generate
APP_DEBUG=false
APP_URL=https://crm.example.ru

APP_LOCALE=ru
APP_TIMEZONE=Europe/Moscow

# База данных MySQL (создать в ISPmanager → Базы данных)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u3531566_bybuka
DB_USERNAME=u3531566_bybuka
DB_PASSWORD=

# Первый аккаунт (создаётся сидером). Смени пароль/PIN после входа.
ADMIN_EMAIL=admin@bybuka.ru
ADMIN_PASSWORD=
ADMIN_PIN=0000

# Сессии/кэш/очереди — на shared-хостинге проще через файлы/БД
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Логи — без daily-ротации шумной
LOG_CHANNEL=stack
LOG_LEVEL=warning
